{
  "components": {
    "data_collection": {
      "modules": [
        {
          "name": "SensorDataCollector",
          "type": "data_collector",
          "description": "Collects real-time sensor data from equipment",
          "protocol": "MQTT",
          "frequency": "continuous"
        },
        {
          "name": "EventLogger",
          "type": "data_collector",
          "description": "Logs events for each processed part",
          "protocol": "REST",
          "frequency": "event-driven"
        }
      ]
    },
    "analytics_engine": {
      "modules": [
        {
          "name": "ProcessAnalyticsEngine",
          "type": "analytics",
          "description": "Analyzes process parameters and calculates KPIs",
          "protocol": "WebSocket",
          "frequency": "real-time"
        }
      ]
    },
    "ml_models": {
      "modules": [
        {
          "name": "PredictiveMaintenanceModel",
          "type": "ml_model",
          "description": "Predicts maintenance needs based on MTTR and availability",
          "protocol": "REST",
          "frequency": "periodic"
        },
        {
          "name": "EnergyConsumptionOptimizer",
          "type": "ml_model",
          "description": "Optimizes energy consumption based on power data",
          "protocol": "REST",
          "frequency": "periodic"
        }
      ]
    },
    "visualization": {
      "modules": [
        {
          "name": "DashboardController",
          "type": "dashboard",
          "description": "Manages dashboard layout and widgets",
          "protocol": "WebSocket",
          "frequency": "refresh_rate"
        }
      ]
    }
  },
  "data_flows": {
    "flows": [
      {
        "source": "SensorDataCollector",
        "destination": "ProcessAnalyticsEngine",
        "protocol": "MQTT",
        "frequency": "continuous"
      },
      {
        "source": "EventLogger",
        "destination": "ProcessAnalyticsEngine",
        "protocol": "REST",
        "frequency": "event-driven"
      },
      {
        "source": "ProcessAnalyticsEngine",
        "destination": "DashboardController",
        "protocol": "WebSocket",
        "frequency": "real-time"
      },
      {
        "source": "ProcessAnalyticsEngine",
        "destination": "PredictiveMaintenanceModel",
        "protocol": "REST",
        "frequency": "periodic"
      },
      {
        "source": "ProcessAnalyticsEngine",
        "destination": "EnergyConsumptionOptimizer",
        "protocol": "REST",
        "frequency": "periodic"
      }
    ]
  },
  "visualization": {
    "layout": {
      "widgets": [
        {
          "type": "KPIWidget",
          "title": "Line Capacity",
          "position": {
            "x": 0,
            "y": 0,
            "width": 2,
            "height": 1
          },
          "refresh_rate": "real-time"
        },
        {
          "type": "KPIWidget",
          "title": "WIP Count",
          "position": {
            "x": 2,
            "y": 0,
            "width": 2,
            "height": 1
          },
          "refresh_rate": "real-time"
        },
        {
          "type": "KPIWidget",
          "title": "Specific Energy Consumption",
          "position": {
            "x": 4,
            "y": 0,
            "width": 2,
            "height": 1
          },
          "refresh_rate": "real-time"
        },
        {
          "type": "AvailabilityChart",
          "title": "Machine Availability (M1-M5)",
          "position": {
            "x": 0,
            "y": 1,
            "width": 4,
            "height": 2
          },
          "refresh_rate": "real-time"
        },
        {
          "type": "ProcessTimeChart",
          "title": "Average Process Time per Part",
          "position": {
            "x": 4,
            "y": 1,
            "width": 2,
            "height": 2
          },
          "refresh_rate": "real-time"
        },
        {
          "type": "PowerConsumptionChart",
          "title": "Energy Consumption",
          "position": {
            "x": 0,
            "y": 3,
            "width": 6,
            "height": 2
          },
          "refresh_rate": "real-time"
        }
      ],
      "color_scheme": {
        "primary": "#007BFF",
        "secondary": "#6C757D",
        "success": "#28A745",
        "warning": "#FFC107",
        "danger": "#DC3545"
      }
    }
  },
  "alerts": {
