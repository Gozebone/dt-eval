        "severity": "warning",
        "value": null,
        "description": "Threshold not defined"
      },
      {
        "parameter": "\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0441\u0442\u044c",
        "severity": "warning",
        "value": null,
        "description": "Threshold not defined"
      },
      {
        "parameter": "MTTR",
        "severity": "warning",
        "value": null,
        "description": "Threshold not defined"
      },
      {
        "parameter": "\u044d\u043d\u0435\u0440\u0433\u043e\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u0432 \u0440\u0430\u0431\u043e\u0442\u0435 (work_power_kw)",
        "severity": "warning",
        "value": null,
        "description": "Threshold not defined"
      },
      {
        "parameter": "\u044d\u043d\u0435\u0440\u0433\u043e\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u0432 \u043f\u0440\u043e\u0441\u0442\u043e\u0435 (idle_power_kw)",
