        "value": null,
        "description": "Threshold not defined"
      }
    ],
    "alert_types": [
      {
        "type": "Info",
        "level": "info",
        "description": "Informational alerts"
      },
      {
        "type": "Warning",
        "level": "warning",
        "description": "Warning level alerts"
      },
      {
        "type": "Critical",
        "level": "critical",
        "description": "Critical level alerts"
      },
      {
        "type": "Emergency",
        "level": "emergency",
        "description": "Emergency level alerts"
      }
    ]
  },
  "kpis": {
    "indicators": [
      {
        "name": "Line Capacity",
        "target_value": "defined by production goals",
        "measurement_method": "throughput rate of the entire line",
        "unit": "parts/hour"
      },
      {
        "name": "WIP Count",
        "target_value": "minimize while maintaining flow",
        "measurement_method": "inventory count at each station",
        "unit": "parts"
      },
      {
        "name": "Specific Energy Consumption",
        "target_value": "optimized energy usage per part",
        "measurement_method": "total energy divided by number of parts produced",
        "unit": "kWh/part"
      },
      {
        "name": "Machine Availability (M1-M5)",
        "target_value": "high availability",
        "measurement_method": "uptime percentage over time period",
        "unit": "%"
      }
    ]
  }
}