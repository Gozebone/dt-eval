{
  "components": {
    "data_collection": {
      "modules": [
        {
          "name": "SensorDataCollector",
          "type": "Data Collection Module",
          "description": "Collects real-time sensor data from machines and buffers",
          "protocol": "MQTT",
          "frequency": "10 Hz"
        },
        {
          "name": "ProcessDataCollector",
          "type": "Data Collection Module",
          "description": "Captures process data including WIP and throughput",
          "protocol": "REST",
          "frequency": "1 Hz"
        }
      ]
    },
    "analytics_engine": {
      "modules": [
        {
          "name": "AvailabilityAnalyzer",
          "type": "Analytics Engine",
          "description": "Analyzes machine availability and MTTR",
          "algorithm": "Statistical Analysis"
        },
        {
          "name": "EnergyConsumptionAnalyzer",
          "type": "Analytics Engine",
          "description": "Calculates energy consumption per part and total usage",
          "algorithm": "Time-series Forecasting"
        },
        {
          "name": "ThroughputAnalyzer",
          "type": "Analytics Engine",
          "description": "Measures line capacity and WIP levels",
          "algorithm": "Queueing Theory"
        }
      ]
    },
    "ml_models": {
      "models": [
        {
          "name": "FailurePredictionModel",
          "type": "ML Model",
          "description": "Predicts potential machine failures based on historical data",
          "algorithm": "Random Forest"
        },
        {
          "name": "EnergyOptimizationModel",
          "type": "ML Model",
          "description": "Suggests optimal operating conditions to reduce energy use",
          "algorithm": "Reinforcement Learning"
        }
      ]
    },
    "visualization": {
      "dashboard": {
        "name": "ProductionLineDashboard",
        "layout": {
          "rows": 3,
          "columns": 4,
          "widgets": [
            {
              "id": "machine_status_widget",
              "type": "StatusCard",
              "position": [
                0,
                0
              ],
              "size": [
                1,
                1
              ],
              "title": "Machine Status"
            },
            {
              "id": "buffer_levels_widget",
              "type": "GaugeChart",
              "position": [
                0,
                1
              ],
              "size": [
                1,
                1
              ],
              "title": "Buffer Levels"
            },
            {
              "id": "energy_consumption_widget",
              "type": "LineChart",
              "position": [
                1,
                0
              ],
              "size": [
                1,
                1
              ],
              "title": "Energy Consumption"
            },
            {
              "id": "throughput_widget",
              "type": "BarChart",
              "position": [
                1,
                1
              ],
              "size": [
                1,
                1
              ],
              "title": "Throughput"
            },
            {
              "id": "wip_widget",
              "type": "StackedBarChart",
              "position": [
                2,
                0
              ],
              "size": [
                1,
                1
              ],
              "title": "Work in Progress"
            },
            {
              "id": "alerts_widget",
              "type": "AlertList",
              "position": [
                2,
                1
              ],
              "size": [
                1,
                1
              ],
              "title": "Active Alerts"
            }
          ]
        },
        "refresh_rate": "5 seconds",
        "color_scheme": {
          "primary": "#4CAF50",
          "secondary": "#FF9800",
          "warning": "#FF5722",
          "critical": "#F44336"
        }
      }
    }
  },
  "data_flows": {
    "connections": [
      {
        "source": "SensorDataCollector",
        "destination": "AnalyticsEngine",
        "protocol": "MQTT",
        "frequency": "10 Hz"
      },
      {
        "source": "ProcessDataCollector",
        "destination": "AnalyticsEngine",
        "protocol": "REST",
        "frequency": "1 Hz"
      },
      {
        "source": "AnalyticsEngine",
        "destination": "MLModels",
        "protocol": "WebSocket",
        "frequency": "Real-time"
      },
      {
        "source": "MLModels",
        "destination": "VisualizationDashboard",
        "protocol": "REST",
        "frequency": "5 seconds"
      },
      {
        "source": "AnalyticsEngine",
        "destination": "AlertSystem",
        "protocol": "WebSocket",
        "frequency": "Real-time"
      }
    ]
  },
  "alerts": {
    "thresholds": [
      {
        "parameter": "machine_availability_M1",
        "threshold": 90,
        "severity": "warning",
        "message": "Machine M1 availability below threshold"
      },
      {
        "parameter": "machine_availability_M2",
        "threshold": 85,
        "severity": "critical",
        "message": "Machine M2 availability critically low"
      },
      {
        "parameter": "buffer_level_B0",
        "threshold": 80,
        "severity": "warning",
        "message": "Buffer B0 level high"
      },
      {
        "parameter": "energy_consumption_per_part",
        "threshold": 1.5,
        "severity": "emergency",
        "message": "Energy consumption per part exceeds standard"
      }
    ],
    "notification_channels": [
      "Email",
      "SMS",
      "Slack"
    ]
  },
  "kpis": {
    "metrics": [
      {
        "name": "Overall Equipment Effectiveness",
        "target_value": 85,
        "measurement_method": "OEE Calculation",
        "unit": "%"
      },
      {
        "name": "Work in Progress",
        "target_value": 50,
        "measurement_method": "Count of parts in buffers",
        "unit": "parts"
      },
      {
        "name": "Specific Energy Consumption",
        "target_value": 1.2,
        "measurement_method": "Total energy consumed / Total parts processed",
        "unit": "kWh/part"
      },
      {
        "name": "Line Throughput",
        "target_value": 200,
        "measurement_method": "Parts produced per hour",
        "unit": "parts/hour"
      },
      {
        "name": "Machine Availability",
        "target_value": 95,
        "measurement_method": "Uptime / (Uptime + Downtime)",
        "unit": "%"
      }
    ]
  }
}