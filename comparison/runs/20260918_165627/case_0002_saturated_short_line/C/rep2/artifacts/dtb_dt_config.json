{
  "components": {
    "data_collection": [
      {
        "id": "dc_001",
        "name": "Sensor Data Collector",
        "type": "Data Collection Module",
        "description": "Collects real-time data from sensors on machines and buffers",
        "protocol": "OPC-UA",
        "update_frequency": "100ms"
      },
      {
        "id": "dc_002",
        "name": "Energy Monitoring System",
        "type": "Data Collection Module",
        "description": "Monitors continuous energy consumption from machines",
        "protocol": "MQTT",
        "update_frequency": "50ms"
      }
    ],
    "analytics": [
      {
        "id": "an_001",
        "name": "Process Analytics Engine",
        "type": "Analytics Engine",
        "description": "Analyzes production data to evaluate throughput and WIP",
        "algorithm": "Time-series Analysis"
      },
      {
        "id": "an_002",
        "name": "Availability Monitor",
        "type": "Analytics Engine",
        "description": "Tracks machine availability and calculates MTTR",
        "algorithm": "Statistical Analysis"
      }
    ],
    "ml_models": [
      {
        "id": "ml_001",
        "name": "Energy Consumption Predictor",
        "type": "ML Model",
        "description": "Predicts energy consumption based on machine usage and load",
        "algorithm": "Regression Analysis"
      },
      {
        "id": "ml_002",
        "name": "Failure Prediction Model",
        "type": "ML Model",
        "description": "Predicts potential failures based on historical data and sensor inputs",
        "algorithm": "Classification"
      }
    ],
    "visualization": [
      {
        "id": "vis_001",
        "name": "Line Monitoring Dashboard",
        "type": "Visualization Dashboard",
        "description": "Real-time dashboard for monitoring the entire production line",
        "widgets": [
          {
            "type": "Gauge",
            "title": "Line Throughput",
            "data_source": "Process Analytics Engine"
          },
          {
            "type": "Chart",
            "title": "WIP Over Time",
            "data_source": "Process Analytics Engine"
          },
          {
            "type": "Map",
            "title": "Machine Availability",
            "data_source": "Availability Monitor"
          },
          {
            "type": "Table",
            "title": "Energy Consumption",
            "data_source": "Energy Monitoring System"
          }
        ]
      }
    ]
  },
  "data_flows": [
    {
      "source": "dc_001",
      "destination": "an_001",
      "protocol": "REST",
      "update_frequency": "100ms",
      "description": "Flow of sensor data to process analytics engine"
    },
    {
      "source": "dc_002",
      "destination": "an_001",
      "protocol": "WebSocket",
      "update_frequency": "50ms",
      "description": "Flow of continuous energy data to analytics engine"
    },
    {
      "source": "an_001",
      "destination": "vis_001",
      "protocol": "REST",
      "update_frequency": "100ms",
      "description": "Flow of processed analytics data to dashboard"
    },
    {
      "source": "an_002",
      "destination": "vis_001",
      "protocol": "REST",
      "update_frequency": "500ms",
      "description": "Flow of availability metrics to dashboard"
    },
    {
      "source": "ml_001",
      "destination": "an_001",
      "protocol": "REST",
      "update_frequency": "1s",
      "description": "Flow of energy consumption predictions to analytics engine"
    },
    {
      "source": "ml_002",
      "destination": "an_002",
      "protocol": "REST",
      "update_frequency": "1s",
      "description": "Flow of failure predictions to availability monitor"
    }
  ],
  "visualization": {
    "dashboard_layout": {
      "rows": 3,
      "columns": 3,
      "widgets": [
        {
          "id": "w_001",
          "position": {
            "row": 1,
            "column": 1
          },
          "type": "Gauge",
          "title": "Line Throughput",
          "refresh_rate": "100ms",
          "color_scheme": "green_to_red"
        },
        {
          "id": "w_002",
          "position": {
            "row": 1,
            "column": 2
          },
          "type": "Chart",
          "title": "WIP Over Time",
          "refresh_rate": "100ms",
          "color_scheme": "blue_to_yellow"
        },
        {
          "id": "w_003",
          "position": {
            "row": 1,
            "column": 3
          },
          "type": "Map",
          "title": "Machine Availability",
          "refresh_rate": "500ms",
          "color_scheme": "green_to_red"
        },
        {
          "id": "w_004",
          "position": {
            "row": 2,
            "column": 1
          },
          "type": "Table",
          "title": "Energy Consumption",
          "refresh_rate": "50ms",
          "color_scheme": "gray"
        },
        {
          "id": "w_005",
          "position": {
            "row": 2,
            "column": 2
          },
          "type": "Chart",
          "title": "Processing Time Distribution",
          "refresh_rate": "100ms",
          "color_scheme": "purple_to_pink"
        },
        {
          "id": "w_006",
          "position": {
            "row": 2,
            "column": 3
          },
          "type": "Status Light",
          "title": "System Status",
          "refresh_rate": "1s",
          "color_scheme": "green_to_red"
        },
        {
          "id": "w_007",
          "position": {
            "row": 3,
            "column": 1
          },
          "type": "Bar Chart",
          "title": "Buffer Levels",
          "refresh_rate": "100ms",
          "color_scheme": "blue"
        },
        {
          "id": "w_008",
          "position": {
            "row": 3,
            "column": 2
          },
          "type": "Heatmap",
          "title": "Energy Consumption Heatmap",
          "refresh_rate": "50ms",
          "color_scheme": "red_to_blue"
        },
        {
          "id": "w_009",
          "position": {
            "row": 3,
            "column": 3
          },
          "type": "Timeline",
          "title": "Machine Activity Timeline",
          "refresh_rate": "100ms",
          "color_scheme": "blue_to_green"
        }
      ]
    }
  },
  "alerts": [
    {
      "id": "alert_001",
      "name": "High WIP Level",
      "description": "Alert when WIP exceeds predefined threshold",
      "trigger": "WIP > 50 units",
      "severity": "warning",
      "action": "Send notification to operator"
    },
    {
      "id": "alert_002",
      "name": "Machine Downtime",
      "description": "Alert when machine is down for more than 5 minutes",
      "trigger": "Machine status = offline for 5+ minutes",
      "severity": "critical",
      "action": "Generate maintenance ticket and notify maintenance team"
    },
    {
      "id": "alert_003",
      "name": "High Energy Consumption",
      "description": "Alert when energy consumption exceeds normal range",
      "trigger": "Energy > 200 kW",
      "severity": "emergency",
      "action": "Switch to energy-saving mode and notify supervisor"
    },
    {
      "id": "alert_004",
      "name": "Buffer Overflow",
      "description": "Alert when buffer capacity exceeds threshold",
      "trigger": "Buffer level > 90%",
      "severity": "warning",
      "action": "Pause downstream process and notify operator"
    },
    {
      "id": "alert_005",
      "name": "Low Throughput",
      "description": "Alert when throughput drops below target",
      "trigger": "Throughput < 50 units/hour",
      "severity": "info",
      "action": "Log and notify process engineer"
    }
  ],
  "kpis": [
    {
      "id": "kpi_001",
      "name": "Line Throughput",
      "description": "Number of parts processed per hour",
      "target_value": "100 units/hour",
      "measurement_method": "Count of processed parts over time",
      "unit": "units/hour"
    },
    {
      "id": "kpi_002",
      "name": "WIP",
      "description": "Work in Progress - number of items in the system",
      "target_value": "30 units",
      "measurement_method": "Inventory count of parts in buffers and machines",
      "unit": "units"
    },
    {
      "id": "kpi_003",
      "name": "Energy Consumption per Part",
      "description": "Average energy used per part processed",
      "target_value": "0.5 kWh/part",
      "measurement_method": "Total energy consumed / Total parts processed",
      "unit": "kWh/part"
    },
    {
      "id": "kpi_004",
      "name": "Machine Availability",
      "description": "Percentage of time machines are operational",
      "target_value": "95%",
      "measurement_method": "(Total Operational Time / Total Time) * 100",
      "unit": "%"
    },
    {
      "id": "kpi_005",
      "name": "MTTR",
      "description": "Mean Time to Repair",
      "target_value": "30 minutes",
      "measurement_method": "Total downtime / Number of breakdowns",
      "unit": "minutes"
    }
  ]
}